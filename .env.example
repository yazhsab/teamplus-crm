# Copy to .env.local for production-mode local testing (port 3000).
# The existing Sites demo on port 5173 uses independent local D1/R2 data.
APP_URL=http://localhost:3000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PROJECT_PUBLISHABLE_KEY
TEAMPLUS_ORGANIZATION_ID=REPLACE_WITH_ORGANIZATION_UUID
# Never put a service-role/secret key in this app's runtime environment.
